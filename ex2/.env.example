# Copy this file to .env and replace every value with a real one.
# .env is ignored by git on purpose: it holds live credentials.

# "development" or "production".
MATRIX_MODE=development

# Connection string for data storage.
DATABASE_URL=sqlite:///matrix_dev.db

# Secret key for external services. Never commit the real one.
API_KEY=replace-with-your-own-key

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=DEBUG

# URL of the resistance network. HTTPS is required in production.
ZION_ENDPOINT=http://localhost:8080
